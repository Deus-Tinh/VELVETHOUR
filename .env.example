# Optional Gemini or OpenAI chat responses. Without a key, rule-based chat remains available.
AI_PROVIDER=gemini
AI_API_KEY=
GEMINI_API_KEY=

AI_MODEL=gemini-3.8-flash
AI_FALLBACK_MODEL=gemini-3.5-flash-lite
AI_REQUEST_TIMEOUT=12000
AI_MAX_OUTPUT_TOKENS=420
# Admin agent makes multiple tool rounds; its timeouts are independent of customer chat.
AI_AGENT_REQUEST_TIMEOUT=30000
AI_AGENT_TIMEOUT=60000
# Fail over only before tools have executed; signed tool history stays on one model.
AI_AGENT_FALLBACK_MODEL=gemini-3.5-flash-lite
AI_AGENT_PRIMARY_TIMEOUT=12000
AI_AGENT_MAX_OUTPUT_TOKENS=4096

# Shared rolling one-second API budget per client IP (1..10000, default 30).
# In production, the backend trusts the Pages-provided IP only after proxy-token validation.
SERENITY_API_RATE_LIMIT=30

# Local-only switch for sample accounts and bookings. Always ignored in production.
SERENITY_SEED_DEMO_DATA=false

# Local/development SQLite paths. Production must explicitly point all paths at the
# mounted persistent volume and the database file must already exist there.
SERENITY_DATA_DIR=server/data
SERENITY_DB_PATH=server/data/serenity.sqlite
SERENITY_BACKUP_DIR=server/data/backups

# Oracle production only. Use /etc/serenity/serenity.env with root:serenity 0640;
# never commit that file. The Pages Function uses the same token as a Pages secret.
SERENITY_PROXY_TOKEN=
SERENITY_INITIAL_ADMIN_EMAIL=
SERENITY_INITIAL_ADMIN_PASSWORD=
SERENITY_INITIAL_ADMIN_NAME=
SERENITY_HOST=127.0.0.1
PORT=3001

# Vercel/Cloudflare API proxy settings (configure in hosting, never in browser code).
SERENITY_API_ORIGIN=https://serenity-api.onrender.com

# SePay inbound transfer confirmation. Keep disabled until the webhook URL is
# deployed over HTTPS and this same API key is configured in the SePay dashboard.
SEPAY_ENABLED=false
# Chế độ chuyển khoản trực tiếp qua mã VietQR Techcombank (miễn phí, duyệt thủ công trên Admin)
VIETQR_DIRECT_ENABLED=true
SEPAY_BANK_NAME=Techcombank
SEPAY_ACCOUNT_NUMBER=
SEPAY_ACCOUNT_HOLDER=
SEPAY_WEBHOOK_API_KEY=

# SMTP settings for sending password reset OTP emails (e.g., Gmail App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Serenity Spa <no-reply@serenityspa.local>

